<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UltimaAnimationForge.ViewModels"
             x:Class="UltimaAnimationForge.Views.Tabs.GumpsTab"
             x:DataType="vm:MainWindowViewModel">

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0"
                Background="#1E232A"
                BorderBrush="#343B46"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">

                <ComboBox Width="145"
                          ItemsSource="{Binding GumpSharpenModes}"
                          SelectedItem="{Binding SelectedGumpSharpenMode}"/>

                <Button Content="Sharpen"
                        Command="{Binding SharpenSelectedGumpCommand}"/>

                <Button Content="Contrast +"
                        Command="{Binding IncreaseGumpContrastCommand}"/>

                <Button Content="Contrast -"
                        Command="{Binding DecreaseGumpContrastCommand}"/>

                <Button Content="Brighten"
                        Command="{Binding BrightenGumpCommand}"/>

                <Button Content="Darken"
                        Command="{Binding DarkenGumpCommand}"/>

                <Button Content="Sat +"
                        Command="{Binding IncreaseGumpSaturationCommand}"/>

                <Button Content="Sat -"
                        Command="{Binding DecreaseGumpSaturationCommand}"/>

                <Button Content="Outline"
                        Command="{Binding OutlineGumpCommand}"/>

                <Button Content="Load Overlay Image"
                        Command="{Binding LoadGumpOverlayImageCommand}"/>

                <TextBlock Text="叠加层不透明度 %"
                           Foreground="#AAB4C0"
                           VerticalAlignment="Center"/>

                <NumericUpDown Minimum="0"
                               Maximum="100"
                               Increment="5"
                               Width="125"
                               Value="{Binding GumpOverlayOpacityPercent}"/>

                <ComboBox Width="120"
                          ItemsSource="{Binding GumpOverlayBlendModes}"
                          SelectedItem="{Binding SelectedGumpOverlayBlendMode}"/>

                <Button Content="Apply Overlay To Gump"
                        Command="{Binding ApplyOverlayToGumpCommand}"/>

                <Button Content="Save Edit"
                        Command="{Binding SaveGumpEditCommand}"/>

                <Button Content="Reset Edit"
                        Command="{Binding ResetGumpEditPreviewCommand}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="300,*,260"
              Background="#111317">

            <Border Grid.Column="0"
                    BorderBrush="#343B46"
                    BorderThickness="0,0,1,0"
                    Background="#161A20"
                    Padding="8">
                <Grid RowDefinitions="Auto,Auto,*">

                    <StackPanel Grid.Row="0"
                                Spacing="6"
                                Margin="0,0,0,8">
                        <TextBlock Text="Search"
                                   FontWeight="Bold"
                                   Foreground="#E4EAF2"/>

                        <TextBox Watermark="Gump ID..."
                                 Text="{Binding GumpSearchText}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Spacing="6"
                                Margin="0,0,0,8">
                        <CheckBox Content="Show free gump slots"
                                  IsChecked="{Binding ShowFreeGumpSlots, Mode=TwoWay}"/>

                        <ComboBox ItemsSource="{Binding GumpFreeSlotModes}"
                                  SelectedItem="{Binding SelectedGumpFreeSlotMode, Mode=TwoWay}"
                                  IsEnabled="{Binding ShowFreeGumpSlots}"/>

                        <TextBlock Text="{Binding GumpSlotSummaryText}"
                                   Foreground="#AAB4C0"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="{Binding GumpWearableSlotSummaryText}"
                                   Foreground="#AAB4C0"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding ShowFreeGumpSlots}"/>

                        <TextBlock Text="{Binding GumpFreeSlotPageText}"
                                   Foreground="#AAB4C0"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding ShowFreeGumpSlots}"/>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6"
                              IsVisible="{Binding ShowFreeGumpSlots}">
                            <Button Grid.Column="0" Content="Previous"
                                    Command="{Binding PreviousGumpFreeSlotPageCommand}"/>
                            <Button Grid.Column="1" Content="Next"
                                    Command="{Binding NextGumpFreeSlotPageCommand}"/>
                        </Grid>
                    </StackPanel>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding GumpEntries}"
                             SelectedItem="{Binding SelectedGump}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*"
                                      Margin="6">
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelectedForExport}"
                                              IsVisible="{Binding IsValid}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayText}"
                                               FontWeight="SemiBold"
                                               Foreground="#E4EAF2"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="1">

                <ScrollViewer IsVisible="{Binding !ShowGumpParallelView}"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Grid HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Margin="16">

                        <Border Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Padding="20">
                            <Canvas Width="300"
                                    Height="400">

                                <Image Source="{Binding PaperdollTemplateBitmap}"
                                       IsVisible="{Binding ShowPaperdollTemplate}"
                                       Opacity="{Binding PaperdollTemplateOpacity}"
                                       Canvas.Left="{Binding PaperdollTemplateOffsetX}"
                                       Canvas.Top="{Binding PaperdollTemplateOffsetY}"
                                       Stretch="None"/>

                                <Image Source="{Binding SelectedGumpBitmap}"
                                       Canvas.Left="{Binding GumpWearableOffsetX}"
                                       Canvas.Top="{Binding GumpWearableOffsetY}"
                                       Stretch="None"/>
                            </Canvas>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <Grid IsVisible="{Binding ShowGumpParallelView}"
                      ColumnDefinitions="*,*">

                    <ScrollViewer Grid.Column="0"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                            <TextBlock Text="Selected"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold"
                                       Foreground="#E4EAF2"/>
                            <Border Margin="16"
                                    Background="#20242B"
                                    BorderBrush="#343B46"
                                    BorderThickness="1"
                                    Padding="20">
                                <Image Source="{Binding SelectedGumpBitmap}"
                                       Stretch="None"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer Grid.Column="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                            <TextBlock Text="{Binding GumpParallelPairText}"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold"
                                       Foreground="#E4EAF2"/>
                            <Border Margin="16"
                                    Background="#20242B"
                                    BorderBrush="#343B46"
                                    BorderThickness="1"
                                    Padding="20">
                                <Image Source="{Binding PairedGumpBitmap}"
                                       Stretch="None"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Border Grid.Column="2"
                    Background="#1A1F26"
                    BorderBrush="#343B46"
                    BorderThickness="1,0,0,0"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="8">

                        <TextBlock Text="Gump Info"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#E4EAF2"/>

                        <Grid ColumnDefinitions="Auto,*"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                              ColumnSpacing="10"
                              RowSpacing="5">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ID" Foreground="#AAB4C0"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedGump.GumpId}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Hex" Foreground="#AAB4C0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedGump.HexId}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Size" Foreground="#AAB4C0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedGump.SizeText}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Length" Foreground="#AAB4C0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedGump.LengthText}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Source" Foreground="#AAB4C0"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedGump.SourceFile}" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="State" Foreground="#AAB4C0"/>
                            <TextBlock Grid.Row="5" Grid.Column="1"
                                       Text="{Binding SelectedGump.DisplayText}"
                                       TextWrapping="Wrap"/>
                        </Grid>

                        <Separator/>

                        <TextBlock Text="Selected Slot" FontWeight="Bold"/>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="6">
                            <Button Grid.Row="0" Grid.Column="0" Content="Import PNG" Command="{Binding ImportPngToGumpCommand}"/>
                            <Button Grid.Row="0" Grid.Column="1" Content="Export PNG" Command="{Binding ExportSelectedGumpCommand}"/>
                            <Button Grid.Row="1" Grid.Column="0" Content="Remove" Command="{Binding RemoveSelectedGumpCommand}"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="Reset Preview" Command="{Binding ResetGumpEditPreviewCommand}"/>
                        </Grid>

                        <Separator/>

                        <TextBlock Text="Checked Slots" FontWeight="Bold"/>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="6">
                            <Button Grid.Row="0" Grid.Column="0" Content="Check Visible" Command="{Binding CheckAllVisibleGumpsCommand}"/>
                            <Button Grid.Row="0" Grid.Column="1" Content="Clear Checks" Command="{Binding ClearCheckedGumpsCommand}"/>
                            <Button Grid.Row="1" Grid.Column="0" Content="Import Checked" Command="{Binding ImportCheckedGumpsCommand}"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="Export Checked" Command="{Binding ExportCheckedGumpsCommand}"/>
                        </Grid>

                        <Separator/>

                        <CheckBox Content="Parallel wearable pair view"
                                  IsChecked="{Binding ShowGumpParallelView, Mode=TwoWay}"/>

                        <CheckBox Content="Show paperdoll template"
                                  IsChecked="{Binding ShowPaperdollTemplate, Mode=TwoWay}"/>

                        <ComboBox ItemsSource="{Binding PaperdollTemplateOptions}"
                                  SelectedItem="{Binding SelectedPaperdollTemplate, Mode=TwoWay}"
                                  IsEnabled="{Binding ShowPaperdollTemplate}"/>

                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6"
                              IsVisible="{Binding ShowPaperdollTemplate}">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Template ID" Foreground="#AAB4C0" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="73727"
                                           Value="{Binding PaperdollTemplateGumpId, Mode=TwoWay}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="不透明度" Foreground="#AAB4C0" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Increment="0.05"
                                           Value="{Binding PaperdollTemplateOpacity, Mode=TwoWay}"/>
                        </Grid>

                        <TextBlock Text="Wearable Offset" FontWeight="Bold"/>
                        <TextBlock Text="{Binding GumpWearableOffsetX, StringFormat='X: {0}'}" Foreground="#AAB4C0"/>
                        <TextBlock Text="{Binding GumpWearableOffsetY, StringFormat='Y: {0}'}" Foreground="#AAB4C0"/>
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="6">
                            <Button Grid.Row="0" Grid.Column="1" Content="↑" Command="{Binding NudgeGumpUpCommand}"/>
                            <Button Grid.Row="1" Grid.Column="0" Content="←" Command="{Binding NudgeGumpLeftCommand}"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="↓" Command="{Binding NudgeGumpDownCommand}"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="→" Command="{Binding NudgeGumpRightCommand}"/>
                        </Grid>
                        <Button Content="Reset Wearable Offset" Command="{Binding ResetGumpWearableOffsetCommand}"/>

                        <Separator/>

                        <TextBlock Text="{Binding GumpInfoText}"
                                   Foreground="#AAB4C0"
                                   TextWrapping="Wrap"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
