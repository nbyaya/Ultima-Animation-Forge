<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UltimaAnimationForge.ViewModels"
             xmlns:converters="clr-namespace:UltimaAnimationForge.Converters"
             x:Class="UltimaAnimationForge.Views.Tabs.GumpBuilderTab"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Resources>
        <converters:BoolToSelectionBrushConverter x:Key="BoolToSelectionBrushConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*"
          RowSpacing="8"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

        <Border Grid.Row="0"
                Background="#202733"
                BorderBrush="#344052"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8">
            <WrapPanel>
                <Button Content="添加背景" Command="{Binding AddGumpBuilderBackgroundCommand}" />
                <Button Content="添加选中窗口" Command="{Binding LoadSelectedGumpIntoBuilderCommand}" />
                <Button Content="添加透明棋盘" Command="{Binding AddGumpBuilderCheckerTransCommand}" />
                <Button Content="添加窗口" Command="{Binding AddGumpBuilderOpenGumpPickerCommand}" />
                <Button Content="添加图像" Command="{Binding AddGumpBuilderImageCommand}" />
                <Button Content="添加嵌入图像" Command="{Binding AddGumpBuilderPicInPicCommand}" />
                <Button Content="添加按钮" Command="{Binding AddGumpBuilderButtonCommand}" />
                <Button Content="添加按钮(美术图)" Command="{Binding AddGumpBuilderButtonTileArtCommand}" />
                <Button Content="添加页面按钮"
                        Command="{Binding AddGumpBuilderPageButtonCommand}" />
                <Button Content="添加文本" Command="{Binding AddGumpBuilderLabelCommand}" />
                <Button Content="添加裁剪文本"
                        Command="{Binding AddGumpBuilderCroppedTextCommand}" />
                <Button Content="添加 HTML" Command="{Binding AddGumpBuilderHtmlCommand}" />
                <Button Content="添加 XMF HTML"
                        Command="{Binding AddGumpBuilderXmfHtmlCommand}" />

                <Button Content="添加 XMF 颜色"
                        Command="{Binding AddGumpBuilderXmfHtmlColorCommand}" />

                <Button Content="添加 XMF 令牌"
                        Command="{Binding AddGumpBuilderXmfHtmlTokCommand}" />
                <Button Content="添加文本输入" Command="{Binding AddGumpBuilderTextEntryCommand}" />
                <Button Content="添加复选框" Command="{Binding AddGumpBuilderCheckboxCommand}" />
                <Button Content="添加单选框" Command="{Binding AddGumpBuilderRadioCommand}" />
                <Button Content="添加组" Command="{Binding AddGumpBuilderGroupStartCommand}" />
                <Button Content="结束组" Command="{Binding AddGumpBuilderGroupEndCommand}" />
                <Button Content="添加页面" Command="{Binding AddGumpBuilderPageCommand}" />
                <Button Content="添加物品属性" Command="{Binding AddGumpBuilderItemPropertyCommand}" />
                <Button Content="添加工具提示" Command="{Binding AddGumpBuilderClilocToolTipCommand}" />
                <Button Content="添加平铺" Command="{Binding AddGumpBuilderTiledImageCommand}" />
                <Button Content="上移" Command="{Binding MoveSelectedGumpBuilderElementUpCommand}" />
                <Button Content="下移" Command="{Binding MoveSelectedGumpBuilderElementDownCommand}" />
                <Button Content="删除" Command="{Binding DeleteSelectedGumpBuilderElementCommand}" />

                <CheckBox Content="对齐网格"
                          IsChecked="{Binding GumpBuilderSnapToGrid}"
                          Foreground="#E4EAF2"
                          VerticalAlignment="Center"
                          Margin="8,0,0,0"/>

                <TextBlock Text="网格"
                           Foreground="#AAB4C0"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>

                <NumericUpDown Value="{Binding GumpBuilderGridSize, Mode=TwoWay}"
                               Minimum="1"
                               Maximum="100"
                               Width="70"/>

                <Menu VerticalAlignment="Center"
                      Margin="8,0,0,0">
                    <MenuItem Header="导出">
                        <MenuItem Header="UOX3 JavaScript"
                                  Command="{Binding ShowGumpBuilderUox3ExportCommand}"/>
                        <MenuItem Header="C#"
                                  Command="{Binding ShowGumpBuilderCSharpExportCommand}"/>
                        <MenuItem Header="Sphere"
                                  Command="{Binding ShowGumpBuilderSphereExportCommand}"/>
                        <MenuItem Header="POL"
                                  Command="{Binding ShowGumpBuilderPolExportCommand}"/>
                    </MenuItem>
                </Menu>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="340,*,380"
              ColumnSpacing="10"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

            <!-- Left: Elements + Properties -->
            <Border Grid.Column="0"
                    Background="#202733"
                    BorderBrush="#344052"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8">

                        <TextBlock Text="窗口选项"
                                   FontWeight="Bold"
                                   Foreground="#E4EAF2"/>

                        <CheckBox Content="主窗口"
                                  IsChecked="{Binding GumpBuilderUseMasterGump}"
                                  Foreground="#E4EAF2"/>

                        <NumericUpDown Value="{Binding GumpBuilderMasterGumpId, Mode=TwoWay}"
                                       Minimum="0"
                                       Maximum="65535"/>

                        <UniformGrid Columns="2"
                                     RowSpacing="4"
                                     ColumnSpacing="6">
                            <CheckBox Content="禁止关闭"
                                      IsChecked="{Binding GumpBuilderNoClose}"
                                      Foreground="#E4EAF2"/>

                            <CheckBox Content="禁止释放"
                                      IsChecked="{Binding GumpBuilderNoDispose}"
                                      Foreground="#E4EAF2"/>

                            <CheckBox Content="禁止移动"
                                      IsChecked="{Binding GumpBuilderNoMove}"
                                      Foreground="#E4EAF2"/>

                            <CheckBox Content="禁止调整大小"
                                      IsChecked="{Binding GumpBuilderNoResize}"
                                      Foreground="#E4EAF2"/>
                        </UniformGrid>

                        <Separator/>

                        <TextBlock Text="元素"
                                   FontWeight="Bold"
                                   Foreground="#E4EAF2"/>

                        <ListBox ItemsSource="{Binding GumpBuilderElements}"
                                 SelectedItem="{Binding SelectedGumpBuilderElement}"
                                 Height="220">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="#E4EAF2"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="{Binding DisplayText}"
                                                   Foreground="#AAB4C0"
                                                   FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Separator/>

                        <TextBlock Text="属性"
                                   FontWeight="Bold"
                                   Foreground="#E4EAF2"/>

                        <UniformGrid Columns="2"
                                     ColumnSpacing="6"
                                     RowSpacing="6">

                            <TextBlock Text="X" Foreground="#AAB4C0"/>
                            <TextBlock Text="Y" Foreground="#AAB4C0"/>

                            <NumericUpDown Value="{Binding SelectedGumpBuilderElement.X, Mode=TwoWay}"
                                           Minimum="-5000"
                                           Maximum="5000"/>
                            <NumericUpDown Value="{Binding SelectedGumpBuilderElement.Y, Mode=TwoWay}"
                                           Minimum="-5000"
                                           Maximum="5000"/>

                            <TextBlock Text="宽度" Foreground="#AAB4C0"/>
                            <TextBlock Text="高度" Foreground="#AAB4C0"/>

                            <NumericUpDown Value="{Binding SelectedGumpBuilderElement.Width, Mode=TwoWay}"
                                           Minimum="1"
                                           Maximum="5000"/>
                            <NumericUpDown Value="{Binding SelectedGumpBuilderElement.Height, Mode=TwoWay}"
                                           Minimum="1"
                                           Maximum="5000"/>

                            <TextBlock Text="窗口 ID / 美术 ID" Foreground="#AAB4C0"/>
                            <TextBlock Text="色调" Foreground="#AAB4C0"/>

                            <NumericUpDown Value="{Binding SelectedGumpBuilderElement.GumpId, Mode=TwoWay}"
                                           Minimum="0"
                                           Maximum="65535"/>
                            <NumericUpDown Value="{Binding SelectedGumpBuilderElement.Hue, Mode=TwoWay}"
                                           Minimum="0"
                                           Maximum="65535"/>

                            <TextBlock Text="按下时窗口 ID" Foreground="#AAB4C0"/>
                            <NumericUpDown Value="{Binding SelectedGumpBuilderElement.PressedGumpId, Mode=TwoWay}"
                                           Minimum="0"
                                           Maximum="65535"/>

                            <TextBlock Text="按钮 ID" Foreground="#AAB4C0"/>
                            <NumericUpDown Value="{Binding SelectedGumpBuilderElement.ButtonId, Mode=TwoWay}"
                                           Minimum="0"
                                           Maximum="9999"/>

                            <TextBlock Grid.Row="14" Grid.Column="0" Text="组编号" Foreground="#AAB4C0"/>

                            <NumericUpDown Grid.Row="15" Grid.Column="0"
                                           Value="{Binding SelectedGumpBuilderElement.GroupNumber, Mode=TwoWay}"
                                           Minimum="0"
                                           Maximum="9999"/>

                            <TextBlock Grid.Row="10" Grid.Column="0" Text="美术 ID" Foreground="#AAB4C0"/>
                            <TextBlock Grid.Row="10" Grid.Column="1" Text="美术色调" Foreground="#AAB4C0"/>

                            <NumericUpDown Grid.Row="11" Grid.Column="0"
                                           Value="{Binding SelectedGumpBuilderElement.TileId, Mode=TwoWay}"
                                           Minimum="0"
                                           Maximum="65535"/>

                            <NumericUpDown Grid.Row="11" Grid.Column="1"
                                           Value="{Binding SelectedGumpBuilderElement.Hue, Mode=TwoWay}"
                                           Minimum="0"
                                           Maximum="65535"/>

                            <TextBlock Grid.Row="12" Grid.Column="0" Text="美术 X 偏移" Foreground="#AAB4C0"/>
                            <TextBlock Grid.Row="12" Grid.Column="1" Text="美术 Y 偏移" Foreground="#AAB4C0"/>

                            <NumericUpDown Grid.Row="13" Grid.Column="0"
                                           Value="{Binding SelectedGumpBuilderElement.TileX, Mode=TwoWay}"
                                           Minimum="-5000"
                                           Maximum="5000"/>

                            <NumericUpDown Grid.Row="13" Grid.Column="1"
                                           Value="{Binding SelectedGumpBuilderElement.TileY, Mode=TwoWay}"
                                           Minimum="-5000"
                                           Maximum="5000"/>

                            <TextBlock Grid.Row="16" Grid.Column="0" Text="页面号" Foreground="#AAB4C0"/>
                            <TextBlock Grid.Row="16" Grid.Column="1" Text="Cliloc 号" Foreground="#AAB4C0"/>

                            <NumericUpDown Grid.Row="17" Grid.Column="0"
                                           Value="{Binding SelectedGumpBuilderElement.PageNumber, Mode=TwoWay}"
                                           Minimum="0"
                                           Maximum="9999"/>

                            <NumericUpDown Grid.Row="17" Grid.Column="1"
                                           Value="{Binding SelectedGumpBuilderElement.ClilocNumber, Mode=TwoWay}"
                                           Minimum="0"
                                           Maximum="999999999"/>

                            <TextBlock Text="物品属性对象"
                                       Foreground="#AAB4C0"/>

                            <TextBox Text="{Binding SelectedGumpBuilderElement.ItemPropertyObject, Mode=TwoWay}"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Z 值" Foreground="#AAB4C0"/>

                            <NumericUpDown Grid.Row="9" Grid.Column="0"
                                           Value="{Binding SelectedGumpBuilderElement.Z, Mode=TwoWay}"
                                           Minimum="-1000"
                                           Maximum="1000"/>

                            <TextBlock Grid.Row="18" Grid.Column="0" Text="精灵 X" Foreground="#AAB4C0"/>
                            <TextBlock Grid.Row="18" Grid.Column="1" Text="精灵 Y" Foreground="#AAB4C0"/>

                            <NumericUpDown Grid.Row="19" Grid.Column="0"
                                           Value="{Binding SelectedGumpBuilderElement.SpriteX, Mode=TwoWay}"
                                           Minimum="0"
                                           Maximum="5000"/>

                            <NumericUpDown Grid.Row="19" Grid.Column="1"
                                           Value="{Binding SelectedGumpBuilderElement.SpriteY, Mode=TwoWay}"
                                           Minimum="0"
                                           Maximum="5000"/>

                            <TextBlock Grid.Row="20" Grid.Column="0" Text="文本 ID" Foreground="#AAB4C0"/>
                            <TextBlock Grid.Row="20" Grid.Column="1" Text="最大长度" Foreground="#AAB4C0"/>

                            <NumericUpDown Grid.Row="21" Grid.Column="0"
                                           Value="{Binding SelectedGumpBuilderElement.TextId, Mode=TwoWay}"
                                           Minimum="0"
                                           Maximum="9999"/>

                            <NumericUpDown Grid.Row="21" Grid.Column="1"
                                           Value="{Binding SelectedGumpBuilderElement.MaxLength, Mode=TwoWay}"
                                           Minimum="0"
                                           Maximum="9999"/>

                        </UniformGrid>

                        <UniformGrid Columns="2"
                                     ColumnSpacing="6"
                                     RowSpacing="4">
                            <CheckBox Content="背景"
                                      IsChecked="{Binding SelectedGumpBuilderElement.HasBackground, Mode=TwoWay}"
                                      Foreground="#E4EAF2"/>

                            <CheckBox Content="滚动条"
                                      IsChecked="{Binding SelectedGumpBuilderElement.HasScrollbar, Mode=TwoWay}"
                                      Foreground="#E4EAF2"/>

                            <CheckBox Content="边框"
                                      IsChecked="{Binding SelectedGumpBuilderElement.HasBorder, Mode=TwoWay}"
                                      Foreground="#E4EAF2"/>

                            <TextBlock Text="RGB 颜色"
                                       Foreground="#AAB4C0"/>
                        </UniformGrid>

                        <NumericUpDown Value="{Binding SelectedGumpBuilderElement.RgbColour, Mode=TwoWay}"
                                       Minimum="0"
                                       Maximum="16777215"/>

                        <TextBlock Text="Cliloc 参数 1" Foreground="#AAB4C0"/>
                        <TextBox Text="{Binding SelectedGumpBuilderElement.ClilocArg1, Mode=TwoWay}"/>

                        <TextBlock Text="Cliloc 参数 2" Foreground="#AAB4C0"/>
                        <TextBox Text="{Binding SelectedGumpBuilderElement.ClilocArg2, Mode=TwoWay}"/>

                        <TextBlock Text="Cliloc 参数 3" Foreground="#AAB4C0"/>
                        <TextBox Text="{Binding SelectedGumpBuilderElement.ClilocArg3, Mode=TwoWay}"/>

                        <CheckBox Content="限制文本输入"
                                  IsChecked="{Binding SelectedGumpBuilderElement.LimitedTextEntry, Mode=TwoWay}"
                                  Foreground="#E4EAF2"/>

                        <Button Content="应用拾取器窗口"
                                Command="{Binding ApplySelectedPickerGumpToElementCommand}"/>

                        <CheckBox Content="默认选中"
                                  IsChecked="{Binding SelectedGumpBuilderElement.DefaultStatus, Mode=TwoWay}"
                                  Foreground="#E4EAF2"/>

                        <TextBlock Text="文本" Foreground="#AAB4C0"/>
                        <TextBox Text="{Binding SelectedGumpBuilderElement.Text, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 Height="90"/>

                        <TextBlock Text="{Binding GumpBuilderStatusText}"
                                   Foreground="#AAB4C0"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Center: Big Canvas -->
            <Border Grid.Column="1"
                    Background="#15191F"
                    BorderBrush="#344052"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">

                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">

                    <Canvas Width="{Binding GumpBuilderWidth}"
                            Height="{Binding GumpBuilderHeight}"
                            Background="#101318"
                            ClipToBounds="False">

                        <ItemsControl x:Name="GumpBuilderItemsControl"
                                      ItemsSource="{Binding GumpBuilderElements}"
                                      Width="{Binding GumpBuilderWidth}"
                                      Height="{Binding GumpBuilderHeight}">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent"
                                            Cursor="SizeAll"
                                            ZIndex="{Binding Z}"
                                            PointerPressed="GumpBuilderElement_PointerPressed"
                                            PointerMoved="GumpBuilderElement_PointerMoved"
                                            PointerReleased="GumpBuilderElement_PointerReleased">

                                        <Border.RenderTransform>
                                            <TranslateTransform X="{Binding X}" Y="{Binding Y}"/>
                                        </Border.RenderTransform>


                                        <Border Padding="6"
                                                Background="Transparent">

                                            <Grid Width="{Binding Width}"
                                                  Height="{Binding Height}"
                                                  ClipToBounds="False">
                                                <Image Source="{Binding Bitmap}"
                                                       Stretch="None"
                                                       UseLayoutRounding="False"
                                                       RenderOptions.BitmapInterpolationMode="None"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Top"/>

                                                <Border Margin="-6"
                                                        BorderBrush="{Binding IsSelected, Converter={StaticResource BoolToSelectionBrushConverter}}"
                                                        BorderThickness="1"
                                                        Background="Transparent"
                                                        IsVisible="{Binding IsSelected}"/>

                                                <Border Background="#3366A6FF"
                                                        Opacity="0.45"
                                                        IsVisible="{Binding !HasBitmap}">
                                                    <TextBlock Text="{Binding Type}"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <Border Width="8" Height="8" Background="White" BorderBrush="Black" BorderThickness="1"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-10,-10,0,0" IsVisible="{Binding IsSelected}" Tag="NW"
                                                        PointerPressed="GumpBuilderResizeHandle_PointerPressed"
                                                        PointerMoved="GumpBuilderResizeHandle_PointerMoved"
                                                        PointerReleased="GumpBuilderResizeHandle_PointerReleased"/>

                                                <Border Width="8" Height="8" Background="White" BorderBrush="Black" BorderThickness="1"
                                                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-10,0,0" IsVisible="{Binding IsSelected}" Tag="N"
                                                        PointerPressed="GumpBuilderResizeHandle_PointerPressed"
                                                        PointerMoved="GumpBuilderResizeHandle_PointerMoved"
                                                        PointerReleased="GumpBuilderResizeHandle_PointerReleased"/>

                                                <Border Width="8" Height="8" Background="White" BorderBrush="Black" BorderThickness="1"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-10,-10,0" IsVisible="{Binding IsSelected}" Tag="NE"
                                                        PointerPressed="GumpBuilderResizeHandle_PointerPressed"
                                                        PointerMoved="GumpBuilderResizeHandle_PointerMoved"
                                                        PointerReleased="GumpBuilderResizeHandle_PointerReleased"/>

                                                <Border Width="8" Height="8" Background="White" BorderBrush="Black" BorderThickness="1"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-10,0,0,0" IsVisible="{Binding IsSelected}" Tag="W"
                                                        PointerPressed="GumpBuilderResizeHandle_PointerPressed"
                                                        PointerMoved="GumpBuilderResizeHandle_PointerMoved"
                                                        PointerReleased="GumpBuilderResizeHandle_PointerReleased"/>

                                                <Border Width="8" Height="8" Background="White" BorderBrush="Black" BorderThickness="1"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-10,0" IsVisible="{Binding IsSelected}" Tag="E"
                                                        PointerPressed="GumpBuilderResizeHandle_PointerPressed"
                                                        PointerMoved="GumpBuilderResizeHandle_PointerMoved"
                                                        PointerReleased="GumpBuilderResizeHandle_PointerReleased"/>

                                                <Border Width="8" Height="8" Background="White" BorderBrush="Black" BorderThickness="1"
                                                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-10,0,0,-10" IsVisible="{Binding IsSelected}" Tag="SW"
                                                        PointerPressed="GumpBuilderResizeHandle_PointerPressed"
                                                        PointerMoved="GumpBuilderResizeHandle_PointerMoved"
                                                        PointerReleased="GumpBuilderResizeHandle_PointerReleased"/>

                                                <Border Width="8" Height="8" Background="White" BorderBrush="Black" BorderThickness="1"
                                                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-10" IsVisible="{Binding IsSelected}" Tag="S"
                                                        PointerPressed="GumpBuilderResizeHandle_PointerPressed"
                                                        PointerMoved="GumpBuilderResizeHandle_PointerMoved"
                                                        PointerReleased="GumpBuilderResizeHandle_PointerReleased"/>

                                                <Border Width="8" Height="8" Background="White" BorderBrush="Black" BorderThickness="1"
                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-10,-10" IsVisible="{Binding IsSelected}" Tag="SE"
                                                        PointerPressed="GumpBuilderResizeHandle_PointerPressed"
                                                        PointerMoved="GumpBuilderResizeHandle_PointerMoved"
                                                        PointerReleased="GumpBuilderResizeHandle_PointerReleased"/>
                                            </Grid>
                                        </Border>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>
                </ScrollViewer>
            </Border>

            <!-- Right: Pickers + Export -->
            <Border Grid.Column="2"
                    Background="#202733"
                    BorderBrush="#344052"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8">

                        <TextBlock Text="窗口拾取器"
                                   FontWeight="Bold"
                                   Foreground="#E4EAF2"/>

                        <DockPanel>
                            <TextBox DockPanel.Dock="Left"
                                     Width="210"
                                     Watermark="窗口 ID / 十六进制"
                                     Text="{Binding GumpBuilderPickerSearchText, Mode=TwoWay}"/>

                            <Button Content="搜索"
                                    Command="{Binding RefreshGumpBuilderPickerCommand}"
                                    Margin="6,0,0,0"/>
                        </DockPanel>

                        <ListBox ItemsSource="{Binding GumpBuilderPickerEntries}"
                                 SelectedItem="{Binding SelectedGumpBuilderPickerEntry}"
                                 Height="160">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="#E4EAF2"
                                               Text="{Binding DisplayText}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Background="#101318"
                                BorderBrush="#344052"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6"
                                Height="140">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <Image Source="{Binding SelectedGumpBuilderGumpPickerPreview}"
                                       Stretch="None"
                                       RenderOptions.BitmapInterpolationMode="None"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </ScrollViewer>
                        </Border>

                        <Button Content="添加选中窗口"
                                Command="{Binding AddSelectedPickerGumpToBuilderCommand}"/>

                        <Separator/>

                        <TextBlock Text="美术拾取器"
                                   FontWeight="Bold"
                                   Foreground="#E4EAF2"/>

                        <DockPanel>
                            <TextBox DockPanel.Dock="Left"
                                     Width="210"
                                     Watermark="美术 ID / 十六进制"
                                     Text="{Binding GumpBuilderArtPickerSearchText, Mode=TwoWay}"/>

                            <Button Content="搜索"
                                    Command="{Binding RefreshGumpBuilderArtPickerCommand}"
                                    Margin="6,0,0,0"/>
                        </DockPanel>

                        <ListBox ItemsSource="{Binding GumpBuilderArtPickerEntries}"
                                 SelectedItem="{Binding SelectedGumpBuilderArtPickerEntry}"
                                 Height="160">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="#E4EAF2"
                                               Text="{Binding DisplayText}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Background="#101318"
                                BorderBrush="#344052"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6"
                                Height="140">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <Image Source="{Binding SelectedGumpBuilderArtPickerPreview}"
                                       Stretch="None"
                                       RenderOptions.BitmapInterpolationMode="None"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </ScrollViewer>
                        </Border>

                        <Button Content="添加选中美术"
                                Command="{Binding AddSelectedArtToGumpBuilderCommand}"/>

                        <Separator/>

                        <Border Background="#15191F"
                                BorderBrush="#344052"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8"
                                IsVisible="{Binding HasGumpBuilderActiveExport}">
                            <StackPanel Spacing="8">

                                <TextBlock Text="{Binding GumpBuilderActiveExportTitle}"
                                           FontWeight="Bold"
                                           Foreground="#E4EAF2"/>

                                <!-- Sphere options only show for Sphere export -->
                                <StackPanel Spacing="6"
                                            IsVisible="{Binding IsGumpBuilderSphereExportVisible}">
                                    <TextBox Text="{Binding GumpBuilderSphereName, Mode=TwoWay}"
                                             Watermark="Sphere 窗口名称"/>

                                    <CheckBox Content="Sphere 0.56 / 修订版"
                                              IsChecked="{Binding GumpBuilderSphereRevision, Mode=TwoWay}"
                                              Foreground="#E4EAF2"/>
                                </StackPanel>

                                <!-- POL options only show for POL export -->
                                <StackPanel Spacing="6"
                                            IsVisible="{Binding IsGumpBuilderPolExportVisible}">
                                    <TextBox Text="{Binding GumpBuilderPolName, Mode=TwoWay}"
                                             Watermark="POL 窗口名称"/>

                                    <CheckBox Content="POL 发行版 Gump 包"
                                              IsChecked="{Binding GumpBuilderPolUseDistro, Mode=TwoWay}"
                                              Foreground="#E4EAF2"/>
                                </StackPanel>

                                <TextBox Text="{Binding GumpBuilderActiveExportText, Mode=TwoWay}"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Height="220"/>

                                <Button Content="{Binding GumpBuilderActiveCopyButtonText}"
                                        Command="{Binding CopyGumpBuilderActiveExportCommand}"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>

</UserControl>
