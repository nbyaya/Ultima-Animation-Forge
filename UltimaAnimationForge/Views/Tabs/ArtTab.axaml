<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UltimaAnimationForge.ViewModels"
             x:Class="UltimaAnimationForge.Views.Tabs.ArtTab"
             x:DataType="vm:MainWindowViewModel">

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0"
                Background="#1E232A"
                BorderBrush="#343B46"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
                <Button Content="加载美术"
                        Command="{Binding LoadArtTabCommand}" />

                <Button Content="美术裁剪"
                        Command="{Binding OpenArtCutterCommand}" />

                <Button Content="导入选定项"
                        Command="{Binding ImportSelectedArtCommand}" />

                <Button Content="批量导入"
                        Command="{Binding MassImportArtCommand}" />

                <Button Content="导出选定项"
                        Command="{Binding ExportSelectedArtCommand}" />

                <Button Content="批量导出"
                        Command="{Binding MassExportArtCommand}" />

                <Button Content="删除已选"
                        Command="{Binding RemoveCheckedArtCommand}" />

                <Button Content="撤销美术更改"
                        Command="{Binding UndoArtChangeCommand}" />

                <Button Content="全部勾选"
                        Command="{Binding CheckAllArtCommand}" />

                <Button Content="全部取消"
                        Command="{Binding UncheckAllArtCommand}" />

                <Button Content="保存美术更改"
                        Command="{Binding SaveArtChangesCommand}" />

                <Button Content="保存图块数据"
                        Command="{Binding SaveTileDataChangesCommand}" />

                <Button Content="保存动画数据"
                        Command="{Binding SaveAnimDataCommand}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="360,*,300"
              ColumnSpacing="10"
              Margin="10">

            <!-- Left: Filters + Art List -->
            <Grid Grid.Column="0"
                  RowDefinitions="Auto,*"
                  RowSpacing="8">

                <Border Grid.Row="0"
                        Background="#20262E"
                        BorderBrush="#343B46"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8">
                    <StackPanel Spacing="6">
                        <TextBox Watermark="搜索名称 / ID / 十六进制..."
                                 Text="{Binding ArtSearchText}" />

                        <ComboBox ItemsSource="{Binding ArtSlotFilterOptions}"
                                  SelectedItem="{Binding SelectedArtSlotFilter}"
                                  Width="180"/>

                        <ComboBox ItemsSource="{Binding ArtEraFilters}"
                                  SelectedItem="{Binding SelectedArtEraFilter}"
                                  PlaceholderText="美术过滤器"
                                  Width="220"/>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="12">
                            <CheckBox Content="地形"
                                      IsChecked="{Binding ShowLandArt}" />

                            <CheckBox Content="静态物品"
                                      IsChecked="{Binding ShowStaticArt}" />

                            <CheckBox Content="美术块"
                                      IsChecked="{Binding ShowArtThumbnails}" />
                            <CheckBox Content="浏览器"
                                      IsChecked="{Binding ShowArtBrowserMode}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Background="#20262E"
                        BorderBrush="#343B46"
                        BorderThickness="1"
                        CornerRadius="6">
                    <ListBox ItemsSource="{Binding ArtEntries}"
                             SelectedItem="{Binding SelectedArtEntry}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,54,*"
                                      ColumnSpacing="8"
                                      Margin="6"
                                      Classes.pendingArt="{Binding IsPendingChange}">
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsChecked}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,6,0"/>

                                    <Border Grid.Column="1"
                                            Width="48"
                                            Height="48"
                                            Background="#151A20"
                                            BorderBrush="#343B46"
                                            BorderThickness="1">
                                        <Image Source="{Binding Thumbnail}"
                                               Tag="Side"
                                               AttachedToVisualTree="ArtThumbnail_AttachedToVisualTree"
                                               DataContextChanged="ArtThumbnail_DataContextChanged"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapInterpolationMode="None"/>
                                    </Border>

                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayText}"
                                                   FontWeight="SemiBold"
                                                   Foreground="#E4EAF2" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- Middle: Preview -->
            <Grid Grid.Column="1"
                  RowDefinitions="*,Auto"
                  RowSpacing="10">

                <Border Grid.Row="0"
                        Background="#20262E"
                        BorderBrush="#343B46"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8">

                    <Grid>

                        <!-- Normal single preview -->
                        <ScrollViewer IsVisible="{Binding ShowArtSinglePreview}"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">

                            <Grid HorizontalAlignment="Center"
                                  VerticalAlignment="Center">

                                <Image Source="{Binding SelectedArtBitmap}"
                                       Stretch="None"
                                       RenderOptions.BitmapInterpolationMode="None"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />

                                <!-- UO 44x44 tile base overlay -->
                                <Path IsVisible="{Binding ShowArtTileBaseOverlay}"
                                      Data="M 0,22 L 22,0 L 44,22 L 22,44 Z"
                                      Stroke="#D14B4B"
                                      StrokeThickness="1"
                                      Fill="#22D14B4B"
                                      Width="44"
                                      Height="44"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Bottom"/>
                            </Grid>
                        </ScrollViewer>

                        <!-- browser preview -->
                        <ScrollViewer IsVisible="{Binding ShowArtBrowserPreview}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsRepeater ItemsSource="{Binding ArtEntries}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="58"
                                                       MinItemHeight="58" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                    <Border Classes="browserTile"
                                            Classes.pendingArt="{Binding IsPendingChange}"
                                            Width="54"
                                            Height="54"
                                            Margin="2"
                                            Background="#151A20"
                                            BorderBrush="#3A4350"
                                            BorderThickness="1"
                                            PointerPressed="ArtBrowserTile_PointerPressed"
                                            PointerEntered="ArtBrowserTile_PointerEntered"
                                            DoubleTapped="ArtBrowserTile_DoubleTapped">

                                        <Grid>
                                            <Image Source="{Binding BrowserThumbnail}"
                                                   Tag="Browser"
                                                   AttachedToVisualTree="ArtThumbnail_AttachedToVisualTree"
                                                   DataContextChanged="ArtThumbnail_DataContextChanged"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapInterpolationMode="None" />

                                            <!-- Checked marker, not a checkbox -->
                                            <Border IsVisible="{Binding IsChecked}"
                                                    BorderBrush="#2D8CFF"
                                                    BorderThickness="2"
                                                    Background="#22163A5C" />

                                            <!-- Pending unsaved marker -->
                                            <Border IsVisible="{Binding IsPendingChange}"
                                                    BorderBrush="#D14B4B"
                                                    BorderThickness="2"
                                                    Background="#22332020" />

                                            <!-- Selected marker must live in the template because
                                                 ItemsRepeater has no ListBoxItem:selected state. -->
                                            <Border IsVisible="{Binding IsSelected}"
                                                    BorderBrush="#2D8CFF"
                                                    BorderThickness="3"
                                                    Background="#18163A5C"
                                                    IsHitTestVisible="False" />
                                        </Grid>
                                    </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>

                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        IsVisible="{Binding ShowSelectedArtAnimDataPreview}"
                        Background="#151A20"
                        BorderBrush="#343B46"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8">
                    <StackPanel Spacing="6">

                        <TextBlock Text="{Binding SelectedArtAnimDataEntry.SecondaryText}"
                                   HorizontalAlignment="Center"
                                   Foreground="#C7D1DB"
                                   FontWeight="SemiBold"/>

                        <Button Content="{Binding ArtAnimDataPlayButtonText}"
                                Command="{Binding ToggleArtAnimDataPlaybackCommand}"
                                HorizontalAlignment="Center"
                                MinWidth="80"/>

                        <ItemsControl ItemsSource="{Binding SelectedArtAnimDataFrames}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Spacing="8"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="58"
                                            Height="70"
                                            Background="#20262E"
                                            BorderBrush="#343B46"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="4">
                                        <StackPanel>
                                            <Image Source="{Binding Bitmap}"
                                                   Stretch="None"
                                                   RenderOptions.BitmapInterpolationMode="None"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Top"/>

                                            <TextBlock Text="{Binding FrameIndex}"
                                                       HorizontalAlignment="Center"
                                                       Foreground="#E4EAF2"
                                                       FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Right: Art Info + TileData Info -->
            <Border Grid.Column="2"
                    Background="#20262E"
                    BorderBrush="#343B46"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">

                        <StackPanel Spacing="4">
                            <TextBlock Text="美术信息"
                                       FontWeight="Bold"
                                       Foreground="#E4EAF2" />

                            <TextBlock Text="{Binding SelectedArtEntry.DisplayText}"
                                       Foreground="#C7D1DB"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="{Binding SelectedArtEntry.SecondaryText}"
                                       Foreground="#AAB4C0"
                                       FontSize="12"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="{Binding SelectedArtVisibleBounds.FullSizeText, StringFormat='完整尺寸: {0}'}"
                                       Foreground="#AAB4C0"
                                       FontSize="12"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="{Binding SelectedArtVisibleBounds.BoundsText, StringFormat='可见范围: {0}'}"
                                       Foreground="#AAB4C0"
                                       FontSize="12"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="{Binding SelectedArtVisibleBounds.VisibleSizeText, StringFormat='可见尺寸: {0}'}"
                                       Foreground="#AAB4C0"
                                       FontSize="12"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="{Binding SelectedArtVisibleBounds.PaddingText, StringFormat='透明填充: {0}'}"
                                       Foreground="#AAB4C0"
                                       FontSize="12"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="雷达颜色"
                                       Foreground="#E4EAF2"
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,0"/>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">

                                <Border Width="34"
                                        Height="20"
                                        Background="{Binding SelectedArtRadarBrush}"
                                        BorderBrush="#566273"
                                        BorderThickness="1"
                                        CornerRadius="3"/>

                                <TextBlock Text="{Binding SelectedArtRadarColorText}"
                                           Foreground="#AAB4C0"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="当前 radarcol.mul 颜色"
                                       Foreground="#E4EAF2"
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,0"/>

                            <StackPanel Spacing="4">

                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">

                                    <Border Width="34"
                                            Height="20"
                                            Background="{Binding SelectedArtCurrentRadarBrush}"
                                            BorderBrush="#566273"
                                            BorderThickness="1"
                                            CornerRadius="3"/>

                                    <TextBlock Text="{Binding SelectedArtCurrentRadarColorText}"
                                               Foreground="#AAB4C0"
                                               FontSize="12"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="{Binding SelectedArtRadarMatchText}"
                                           Foreground="#E6C86E"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="42,2,0,0"/>

                            </StackPanel>

                            <WrapPanel Orientation="Horizontal"
                                       Margin="0,6,0,0">

                                <Button Content="应用生成"
                                        Command="{Binding ApplyGeneratedRadarColorToSelectedArtCommand}"
                                        MinWidth="120"
                                        Margin="0,0,6,6"/>

                                <Button Content="应用已选"
                                        Command="{Binding ApplyGeneratedRadarColorToCheckedArtCommand}"
                                        MinWidth="110"
                                        Margin="0,0,6,6"/>

                                <Button Content="还原"
                                        Command="{Binding RevertSelectedRadarColorCommand}"
                                        MinWidth="80"
                                        Margin="0,0,6,6"/>

                                <Button Content="保存雷达颜色"
                                        Command="{Binding SaveRadarColCommand}"
                                        MinWidth="110"
                                        Margin="0,0,6,6"/>
                            </WrapPanel>
                        </StackPanel>

                        <Border Height="1"
                                Background="#343B46"
                                Margin="0,4"/>

                        <StackPanel Spacing="4">
                            <TextBlock Text="图块数据信息"
                                       FontWeight="Bold"
                                       Foreground="#E4EAF2" />

                            <TextBlock Text="{Binding SelectedArtTileDataEntry.DisplayText}"
                                       Foreground="#C7D1DB"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="{Binding SelectedArtTileDataEntry.Flags, StringFormat='标志: 0x{0:X16}'}"
                                       Foreground="#AAB4C0"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="{Binding SelectedArtTileDataFlagNames, StringFormat='标志名称: {0}'}"
                                       Foreground="#AAB4C0"
                                       TextWrapping="Wrap" />

                            <Button Content="编辑标志..."
                                    Command="{Binding OpenArtTileDataFlagsCommand}" />

                            <Button Content="{Binding ArtAnimDataEditButtonText}"
                                    Command="{Binding OpenArtAnimDataEditorCommand}" />

                            <CheckBox Content="显示图块数据编辑器"
                                      IsChecked="{Binding ShowArtTileDataEditor}"
                                      Foreground="#C7D1DB"/>

                            <CheckBox Content="将字段更改应用到已选美术"
                                      IsChecked="{Binding ApplyTileDataFieldsToCheckedArt}"
                                      Foreground="#C7D1DB"
                                      Margin="0,6,0,8"/>

                            <StackPanel IsVisible="{Binding ShowArtTileDataEditor}"
                                        Spacing="4">

                                <TextBlock Text="名称" Foreground="#AAB4C0"/>
                                <TextBox Text="{Binding SelectedArtTileDataEntry.Name, Mode=TwoWay}"
                                         LostFocus="ArtTileDataEditField_LostFocus"/>

                                <TextBlock Text="动画/Gump" Foreground="#AAB4C0"/>
                                <NumericUpDown Value="{Binding SelectedArtTileDataEntry.Animation, Mode=TwoWay}"
                                               Minimum="0"
                                               Maximum="640000"
                                               Increment="1"
                                               FormatString="0"
                                               LostFocus="ArtTileDataEditField_LostFocus"/>

                                <TextBlock Text="重量" Foreground="#AAB4C0"/>
                                <NumericUpDown Value="{Binding SelectedArtTileDataEntry.Weight, Mode=TwoWay}"
                                               Minimum="0"
                                               Maximum="255"
                                               Increment="1"
                                               FormatString="0"
                                               LostFocus="ArtTileDataEditField_LostFocus"/>

                                <TextBlock Text="品质/层/光" Foreground="#AAB4C0"/>
                                <NumericUpDown Value="{Binding SelectedArtTileDataEntry.Quality, Mode=TwoWay}"
                                               Minimum="0"
                                               Maximum="255"
                                               Increment="1"
                                               FormatString="0"
                                               LostFocus="ArtTileDataEditField_LostFocus"/>

                                <TextBlock Text="数量" Foreground="#AAB4C0"/>
                                <NumericUpDown Value="{Binding SelectedArtTileDataEntry.Quantity, Mode=TwoWay}"
                                               Minimum="0"
                                               Maximum="255"
                                               Increment="1"
                                               FormatString="0"
                                               LostFocus="ArtTileDataEditField_LostFocus"/>

                                <TextBlock Text="Hue" Foreground="#AAB4C0"/>
                                <NumericUpDown Value="{Binding SelectedArtTileDataEntry.Hue, Mode=TwoWay}"
                                               Minimum="0"
                                               Maximum="255"
                                               Increment="1"
                                               FormatString="0"
                                               LostFocus="ArtTileDataEditField_LostFocus"/>

                                <TextBlock Text="堆叠偏移" Foreground="#AAB4C0"/>
                                <NumericUpDown Value="{Binding SelectedArtTileDataEntry.StackingOffset, Mode=TwoWay}"
                                               Minimum="0"
                                               Maximum="255"
                                               Increment="1"
                                               FormatString="0"
                                               LostFocus="ArtTileDataEditField_LostFocus"/>

                                <TextBlock Text="值" Foreground="#AAB4C0"/>
                                <NumericUpDown Value="{Binding SelectedArtTileDataEntry.Value, Mode=TwoWay}"
                                               Minimum="0"
                                               Maximum="255"
                                               Increment="1"
                                               FormatString="0"
                                               LostFocus="ArtTileDataEditField_LostFocus"/>

                                <TextBlock Text="高度" Foreground="#AAB4C0"/>
                                <NumericUpDown Value="{Binding SelectedArtTileDataEntry.Height, Mode=TwoWay}"
                                               Minimum="0"
                                               Maximum="255"
                                               Increment="1"
                                               FormatString="0"
                                               LostFocus="ArtTileDataEditField_LostFocus"/>
                            </StackPanel>
                        </StackPanel>

                        <Expander Header="图像工具"
                                  IsExpanded="{Binding ShowArtImageTools}">
                            <StackPanel Spacing="8"
                                        Margin="0,8,0,0">

                                <TextBlock Text="增强"
                                           FontWeight="Bold"
                                           Foreground="#E4EAF2"/>

                                <TextBlock Text="{Binding ArtBrightness, StringFormat='亮度: {0:0}'}"/>
                                <Slider Minimum="-80"
                                        Maximum="80"
                                        Value="{Binding ArtBrightness}"/>

                                <TextBlock Text="{Binding ArtContrast, StringFormat='对比度: {0:0}'}"/>
                                <Slider Minimum="-80"
                                        Maximum="80"
                                        Value="{Binding ArtContrast}"/>

                                <TextBlock Text="{Binding ArtSharpness, StringFormat='锐度: {0:0}'}"/>
                                <Slider Minimum="0"
                                        Maximum="100"
                                        Value="{Binding ArtSharpness}"/>

                                <ComboBox Width="110"
                                          ItemsSource="{Binding ArtSharpenModes}"
                                          SelectedItem="{Binding SelectedArtSharpenMode}"/>

                                <Button Content="应用增强"
                                        Command="{Binding ApplyArtEnhancementCommand}"/>

                                <Border Height="1"
                                        Background="#343B46"
                                        Margin="0,4"/>

                                <TextBlock Text="叠加层"
                                           FontWeight="Bold"
                                           Foreground="#E4EAF2"/>

                                <Button Content="加载叠加层图像"
                                        Command="{Binding LoadArtOverlayImageCommand}"/>

                                <TextBlock Text="{Binding ArtOverlayOpacity, StringFormat='不透明度: {0:0}%'}"/>
                                <Slider Minimum="0"
                                        Maximum="100"
                                        Value="{Binding ArtOverlayOpacity}"/>

                                <ComboBox ItemsSource="{Binding ArtOverlayBlendModes}"
                                          SelectedItem="{Binding SelectedArtOverlayBlendMode}"/>

                                <Button Content="应用叠加层到美术"
                                        Command="{Binding ApplyArtOverlayCommand}"/>

                                <Border Height="1"
                                        Background="#343B46"
                                        Margin="0,4"/>

                                <Button Content="队列美术编辑"
                                        Command="{Binding QueueSelectedArtEditCommand}"/>

                                <Button Content="重置编辑"
                                        Command="{Binding ResetArtEditCommand}"/>
                            </StackPanel>
                        </Expander>

                        <CheckBox Content="显示 UO 图块基础"
                                  IsChecked="{Binding ShowArtTileBaseOverlay}"
                                  Foreground="#C7D1DB"
                                  Margin="0,6,0,0"/>

                        <Border Height="1"
                                Background="#343B46"
                                Margin="0,8,0,4"/>

                        <StackPanel Spacing="4"
                                    IsVisible="{Binding ShowSelectedArtEquipmentGump}">
                            <TextBlock Text="装备 Gump"
                                       FontWeight="Bold"
                                       Foreground="#E4EAF2" />

                            <TextBlock Text="{Binding SelectedArtMaleEquipmentGumpText}"
                                       Foreground="#AAB4C0"
                                       TextWrapping="Wrap" />

                            <Border Background="#151A20"
                                    BorderBrush="#343B46"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8"
                                    HorizontalAlignment="Left">
                                <Image Source="{Binding SelectedArtMaleEquipmentGumpBitmap}"
                                       Stretch="None"
                                       RenderOptions.BitmapInterpolationMode="None" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>

</UserControl>
