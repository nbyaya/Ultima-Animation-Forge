<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UltimaAnimationForge.ViewModels"
             x:Class="UltimaAnimationForge.Views.Tabs.LightsTab"
             x:DataType="vm:MainWindowViewModel">

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" Background="#1E232A" Padding="12,8">
            <WrapPanel Orientation="Horizontal">
                <Button Content="加载" Command="{Binding LoadLightsCommand}" Margin="0,0,6,6"/>
                <Button Content="保存" Command="{Binding SaveLightsCommand}" Margin="0,0,6,6"/>
                <Button Content="重置" Command="{Binding ResetLightsCommand}" Margin="0,0,6,6"/>
                <Button Content="撤销" Command="{Binding UndoLightEditCommand}" Margin="0,0,6,6"/>
                <Button Content="重做" Command="{Binding RedoLightEditCommand}" Margin="0,0,6,6"/>

                <CheckBox Content="显示已删除"
                          IsChecked="{Binding ShowRemovedLightSlots, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="0,0,10,6"/>

                <Button Content="导入 PNG" Command="{Binding ImportSelectedLightPngCommand}" Margin="0,0,6,6"/>
                <Button Content="导出 PNG" Command="{Binding ExportSelectedLightPngCommand}" Margin="0,0,10,6"/>

                <TextBlock Text="宽" VerticalAlignment="Center" Foreground="#AAB4C0" Margin="0,0,4,6"/>
                <NumericUpDown Value="{Binding NewLightWidth, Mode=TwoWay}"
                               Minimum="8"
                               Maximum="600"
                               Width="120"
                               FormatString="0"/>

                <TextBlock Text="高" VerticalAlignment="Center" Foreground="#AAB4C0" Margin="0,0,4,6"/>
                <NumericUpDown Value="{Binding NewLightHeight, Mode=TwoWay}"
                               Minimum="8"
                               Maximum="600"
                               Width="120"
                               FormatString="0"/>

                <TextBlock Text="强度" VerticalAlignment="Center" Foreground="#AAB4C0" Margin="0,0,4,6"/>
                <NumericUpDown Value="{Binding LightPresetStrength, Mode=TwoWay}"
                               Minimum="1"
                               Maximum="31"
                               Width="120"
                               FormatString="0"
                               Margin="0,0,10,6"/>

                <Button Content="光源工具" Margin="0,0,10,6">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="新建空白" Command="{Binding CreateBlankLightCommand}" />
                            <MenuItem Header="清除选中" Command="{Binding ClearSelectedLightCommand}" />
                            <MenuItem Header="删除选中" Command="{Binding RemoveSelectedLightCommand}" />
                            <MenuItem Header="圆形预设" Command="{Binding CreateRoundLightCommand}" />
                            <MenuItem Header="窗口预设" Command="{Binding CreateWindowLightCommand}" />
                            <MenuItem Header="门缝预设" Command="{Binding CreateDoorSlitLightCommand}" />
                            <MenuItem Header="柔和选中" Command="{Binding SoftenSelectedLightCommand}" />
                            <MenuItem Header="锐化选中" Command="{Binding SharpenSelectedLightCommand}" />
                            <MenuItem Header="水平翻转" Command="{Binding FlipSelectedLightHorizontalCommand}" />
                            <MenuItem Header="竖直翻转" Command="{Binding FlipSelectedLightVerticalCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <TextBlock Text="笔刷" VerticalAlignment="Center" Foreground="#AAB4C0" Margin="0,0,4,6"/>
                <NumericUpDown Value="{Binding LightBrushSize, Mode=TwoWay}"
                               Minimum="1"
                               Maximum="100"
                               Width="120"
                               FormatString="0"
                               Margin="0,0,6,6"/>

                <TextBlock Text="绘制" VerticalAlignment="Center" Foreground="#AAB4C0" Margin="0,0,4,6"/>
                <NumericUpDown Value="{Binding LightBrushStrength, Mode=TwoWay}"
                               Minimum="1"
                               Maximum="31"
                               Width="120"
                               FormatString="0"
                               Margin="0,0,6,6"/>

                <CheckBox Content="擦除"
                          IsChecked="{Binding LightBrushErase, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="0,0,6,6"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="300,*"
              Margin="10"
              ColumnSpacing="10">

            <ListBox Grid.Column="0"
                     ItemsSource="{Binding LightEntries}"
                     SelectedItem="{Binding SelectedLightEntry}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SizeText}" Foreground="#AAB4C0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border x:Name="LightPreviewPaintSurface"
                    Grid.Column="1"
                    Background="#D0D0D0"
                    BorderBrush="#343B46"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    PointerPressed="LightPreviewPaintSurface_PointerPressed"
                    PointerMoved="LightPreviewPaintSurface_PointerMoved"
                    PointerReleased="LightPreviewPaintSurface_PointerReleased">

                <Image x:Name="LightPreviewImage"
                       Source="{Binding SelectedLightEntry.Preview, TargetNullValue={x:Null}}"
                       Stretch="None"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
